    },
    "statistics": {
      "projectType": "library",
      "root": "projects/statistics",
      "sourceRoot": "projects/statistics/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
