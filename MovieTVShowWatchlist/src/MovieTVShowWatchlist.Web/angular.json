      }
    },
    "watchlist": {
      "projectType": "library",
      "root": "projects/watchlist",
      "sourceRoot": "projects/watchlist/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/watchlist/ng-package.json"
          },
          "configurations": {
