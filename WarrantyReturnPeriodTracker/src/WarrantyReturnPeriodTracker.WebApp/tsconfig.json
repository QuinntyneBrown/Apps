{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "lib": [
      "ES2022",
      "dom"
    ],
    "paths": {
      "@lib/shared": [
        "projects/warranty-return-period-tracker-shared/src/public-api.ts"
      ],
      "@lib/dashboard": [
        "projects/warranty-return-period-tracker-dashboard/src/public-api.ts"
      ],
      "@lib/purchases": [
        "projects/warranty-return-period-tracker-purchases/src/public-api.ts"
      ],
      "@lib/receipts": [
        "projects/warranty-return-period-tracker-receipts/src/public-api.ts"
      ],
      "@lib/return-windows": [
        "projects/warranty-return-period-tracker-return-windows/src/public-api.ts"
      ],
      "@lib/warranties": [
        "projects/warranty-return-period-tracker-warranties/src/public-api.ts"
      ]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
