{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "anniversary-birthday-reminder": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "standalone": true
        },
        "@schematics/angular:directive": {
          "standalone": true
        },
        "@schematics/angular:pipe": {
          "standalone": true
        }
      },
      "root": "projects/anniversary-birthday-reminder",
      "sourceRoot": "projects/anniversary-birthday-reminder/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/anniversary-birthday-reminder",
            "index": "projects/anniversary-birthday-reminder/src/index.html",
            "browser": "projects/anniversary-birthday-reminder/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/anniversary-birthday-reminder/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/anniversary-birthday-reminder/public"
              }
            ],
            "styles": [
              "projects/anniversary-birthday-reminder/src/styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kB",
                  "maximumError": "4kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "anniversary-birthday-reminder:build:production"
            },
            "development": {
              "buildTarget": "anniversary-birthday-reminder:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/anniversary-birthday-reminder/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/anniversary-birthday-reminder/public"
              }
            ],
            "styles": [
              "projects/anniversary-birthday-reminder/src/styles.scss"
            ],
            "scripts": []
          }
        }
      }
    },
    "anniversary-birthday-reminder-shared": {
      "projectType": "library",
      "root": "projects/anniversary-birthday-reminder-shared",
      "sourceRoot": "projects/anniversary-birthday-reminder-shared/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/anniversary-birthday-reminder-shared/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/anniversary-birthday-reminder-shared/tsconfig.lib.json"
            }
          }
        }
      }
    },
    "anniversary-birthday-reminder-celebrations": {
      "projectType": "library",
      "root": "projects/anniversary-birthday-reminder-celebrations",
      "sourceRoot": "projects/anniversary-birthday-reminder-celebrations/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/anniversary-birthday-reminder-celebrations/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/anniversary-birthday-reminder-celebrations/tsconfig.lib.json"
            }
          }
        }
      }
    },
    "anniversary-birthday-reminder-dashboard": {
      "projectType": "library",
      "root": "projects/anniversary-birthday-reminder-dashboard",
      "sourceRoot": "projects/anniversary-birthday-reminder-dashboard/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/anniversary-birthday-reminder-dashboard/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/anniversary-birthday-reminder-dashboard/tsconfig.lib.json"
            }
          }
        }
      }
    },
    "anniversary-birthday-reminder-dates": {
      "projectType": "library",
      "root": "projects/anniversary-birthday-reminder-dates",
      "sourceRoot": "projects/anniversary-birthday-reminder-dates/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/anniversary-birthday-reminder-dates/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/anniversary-birthday-reminder-dates/tsconfig.lib.json"
            }
          }
        }
      }
    },
    "anniversary-birthday-reminder-gifts": {
      "projectType": "library",
      "root": "projects/anniversary-birthday-reminder-gifts",
      "sourceRoot": "projects/anniversary-birthday-reminder-gifts/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/anniversary-birthday-reminder-gifts/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/anniversary-birthday-reminder-gifts/tsconfig.lib.json"
            }
          }
        }
      }
    },
    "anniversary-birthday-reminder-reminders": {
      "projectType": "library",
      "root": "projects/anniversary-birthday-reminder-reminders",
      "sourceRoot": "projects/anniversary-birthday-reminder-reminders/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/anniversary-birthday-reminder-reminders/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/anniversary-birthday-reminder-reminders/tsconfig.lib.json"
            }
          }
        }
      }
    }
  }
}
