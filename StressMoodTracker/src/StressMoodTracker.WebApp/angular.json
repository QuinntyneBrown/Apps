{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "stress-mood-tracker": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "standalone": true
        },
        "@schematics/angular:directive": {
          "standalone": true
        },
        "@schematics/angular:pipe": {
          "standalone": true
        }
      },
      "root": "projects/stress-mood-tracker",
      "sourceRoot": "projects/stress-mood-tracker/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/stress-mood-tracker",
            "index": "projects/stress-mood-tracker/src/index.html",
            "browser": "projects/stress-mood-tracker/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/stress-mood-tracker/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/stress-mood-tracker/public"
              }
            ],
            "styles": [
              "projects/stress-mood-tracker/src/styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kB",
                  "maximumError": "4kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "stress-mood-tracker:build:production"
            },
            "development": {
              "buildTarget": "stress-mood-tracker:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/stress-mood-tracker/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/stress-mood-tracker/public"
              }
            ],
            "styles": [
              "projects/stress-mood-tracker/src/styles.scss"
            ],
            "scripts": []
          }
        }
      }
    },
    "stress-mood-tracker-shared": {
      "projectType": "library",
      "root": "projects/stress-mood-tracker-shared",
      "sourceRoot": "projects/stress-mood-tracker-shared/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/stress-mood-tracker-shared/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/stress-mood-tracker-shared/tsconfig.lib.json"
            }
          }
        }
      }
    },
    "stress-mood-tracker-dashboard": {
      "projectType": "library",
      "root": "projects/stress-mood-tracker-dashboard",
      "sourceRoot": "projects/stress-mood-tracker-dashboard/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/stress-mood-tracker-dashboard/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/stress-mood-tracker-dashboard/tsconfig.lib.json"
            }
          }
        }
      }
    },
    "stress-mood-tracker-journals": {
      "projectType": "library",
      "root": "projects/stress-mood-tracker-journals",
      "sourceRoot": "projects/stress-mood-tracker-journals/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/stress-mood-tracker-journals/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/stress-mood-tracker-journals/tsconfig.lib.json"
            }
          }
        }
      }
    },
    "stress-mood-tracker-mood-entries": {
      "projectType": "library",
      "root": "projects/stress-mood-tracker-mood-entries",
      "sourceRoot": "projects/stress-mood-tracker-mood-entries/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/stress-mood-tracker-mood-entries/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/stress-mood-tracker-mood-entries/tsconfig.lib.json"
            }
          }
        }
      }
    },
    "stress-mood-tracker-triggers": {
      "projectType": "library",
      "root": "projects/stress-mood-tracker-triggers",
      "sourceRoot": "projects/stress-mood-tracker-triggers/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/stress-mood-tracker-triggers/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/stress-mood-tracker-triggers/tsconfig.lib.json"
            }
          }
        }
      }
    }
  }
}
