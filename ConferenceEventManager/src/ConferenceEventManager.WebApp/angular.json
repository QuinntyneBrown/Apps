{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "conference-event-manager": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "standalone": true
        },
        "@schematics/angular:directive": {
          "standalone": true
        },
        "@schematics/angular:pipe": {
          "standalone": true
        }
      },
      "root": "projects/conference-event-manager",
      "sourceRoot": "projects/conference-event-manager/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/conference-event-manager",
            "index": "projects/conference-event-manager/src/index.html",
            "browser": "projects/conference-event-manager/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/conference-event-manager/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/conference-event-manager/public"
              }
            ],
            "styles": [
              "projects/conference-event-manager/src/styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kB",
                  "maximumError": "4kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "conference-event-manager:build:production"
            },
            "development": {
              "buildTarget": "conference-event-manager:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/conference-event-manager/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/conference-event-manager/public"
              }
            ],
            "styles": [
              "projects/conference-event-manager/src/styles.scss"
            ],
            "scripts": []
          }
        }
      }
    },
    "conference-event-manager-shared": {
      "projectType": "library",
      "root": "projects/conference-event-manager-shared",
      "sourceRoot": "projects/conference-event-manager-shared/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/conference-event-manager-shared/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/conference-event-manager-shared/tsconfig.lib.json"
            }
          }
        }
      }
    },
    "conference-event-manager-contacts": {
      "projectType": "library",
      "root": "projects/conference-event-manager-contacts",
      "sourceRoot": "projects/conference-event-manager-contacts/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/conference-event-manager-contacts/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/conference-event-manager-contacts/tsconfig.lib.json"
            }
          }
        }
      }
    },
    "conference-event-manager-dashboard": {
      "projectType": "library",
      "root": "projects/conference-event-manager-dashboard",
      "sourceRoot": "projects/conference-event-manager-dashboard/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/conference-event-manager-dashboard/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/conference-event-manager-dashboard/tsconfig.lib.json"
            }
          }
        }
      }
    },
    "conference-event-manager-events": {
      "projectType": "library",
      "root": "projects/conference-event-manager-events",
      "sourceRoot": "projects/conference-event-manager-events/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/conference-event-manager-events/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/conference-event-manager-events/tsconfig.lib.json"
            }
          }
        }
      }
    },
    "conference-event-manager-notes": {
      "projectType": "library",
      "root": "projects/conference-event-manager-notes",
      "sourceRoot": "projects/conference-event-manager-notes/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/conference-event-manager-notes/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/conference-event-manager-notes/tsconfig.lib.json"
            }
          }
        }
      }
    },
    "conference-event-manager-sessions": {
      "projectType": "library",
      "root": "projects/conference-event-manager-sessions",
      "sourceRoot": "projects/conference-event-manager-sessions/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/conference-event-manager-sessions/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/conference-event-manager-sessions/tsconfig.lib.json"
            }
          }
        }
      }
    }
  }
}
