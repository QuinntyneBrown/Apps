{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "conference-event-manager": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "standalone": true
        },
        "@schematics/angular:directive": {
          "standalone": true
        },
        "@schematics/angular:pipe": {
          "standalone": true
        }
      },
      "root": "projects/conference-event-manager",
      "sourceRoot": "projects/conference-event-manager/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/conference-event-manager",
            "index": "projects/conference-event-manager/src/index.html",
            "browser": "projects/conference-event-manager/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/conference-event-manager/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/conference-event-manager/public"
              }
            ],
            "styles": [
              "projects/conference-event-manager/src/styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kB",
                  "maximumError": "4kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "conference-event-manager:build:production"
            },
            "development": {
              "buildTarget": "conference-event-manager:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/conference-event-manager/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/conference-event-manager/public"
              }
            ],
            "styles": [
              "projects/conference-event-manager/src/styles.scss"
            ],
            "scripts": []
          }
        }
      }
    },
    "api": {
      "projectType": "library",
      "root": "projects/api",
      "sourceRoot": "projects/api/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/api/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/api/tsconfig.lib.json"
            }
          }
        }
      }
    },
    "contacts": {
      "projectType": "library",
      "root": "projects/contacts",
      "sourceRoot": "projects/contacts/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/contacts/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/contacts/tsconfig.lib.json"
            }
          }
        }
      }
    },
    "dashboard": {
      "projectType": "library",
      "root": "projects/dashboard",
      "sourceRoot": "projects/dashboard/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/dashboard/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/dashboard/tsconfig.lib.json"
            }
          }
        }
      }
    },
    "events": {
      "projectType": "library",
      "root": "projects/events",
      "sourceRoot": "projects/events/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/events/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/events/tsconfig.lib.json"
            }
          }
        }
      }
    },
    "notes": {
      "projectType": "library",
      "root": "projects/notes",
      "sourceRoot": "projects/notes/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/notes/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/notes/tsconfig.lib.json"
            }
          }
        }
      }
    },
    "sessions": {
      "projectType": "library",
      "root": "projects/sessions",
      "sourceRoot": "projects/sessions/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/sessions/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/sessions/tsconfig.lib.json"
            }
          }
        }
      }
    },
    "components": {
      "projectType": "library",
      "root": "projects/components",
      "sourceRoot": "projects/components/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/components/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/components/tsconfig.lib.json"
            }
          }
        }
      }
    }
  }
}
