{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "lib": [
      "ES2022",
      "dom"
    ],
    "paths": {
      "@lib/shared": [
        "projects/side-hustle-income-tracker-shared/src/public-api.ts"
      ],
      "@lib/businesses": [
        "projects/side-hustle-income-tracker-businesses/src/public-api.ts"
      ],
      "@lib/dashboard": [
        "projects/side-hustle-income-tracker-dashboard/src/public-api.ts"
      ],
      "@lib/expenses": [
        "projects/side-hustle-income-tracker-expenses/src/public-api.ts"
      ],
      "@lib/incomes": [
        "projects/side-hustle-income-tracker-incomes/src/public-api.ts"
      ],
      "@lib/tax-estimates": [
        "projects/side-hustle-income-tracker-tax-estimates/src/public-api.ts"
      ]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
