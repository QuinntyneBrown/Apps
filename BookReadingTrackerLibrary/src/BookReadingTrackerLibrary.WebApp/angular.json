{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "book-reading-tracker-library": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "standalone": true
        },
        "@schematics/angular:directive": {
          "standalone": true
        },
        "@schematics/angular:pipe": {
          "standalone": true
        }
      },
      "root": "projects/book-reading-tracker-library",
      "sourceRoot": "projects/book-reading-tracker-library/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/book-reading-tracker-library",
            "index": "projects/book-reading-tracker-library/src/index.html",
            "browser": "projects/book-reading-tracker-library/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/book-reading-tracker-library/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/book-reading-tracker-library/public"
              }
            ],
            "styles": [
              "projects/book-reading-tracker-library/src/styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kB",
                  "maximumError": "4kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "book-reading-tracker-library:build:production"
            },
            "development": {
              "buildTarget": "book-reading-tracker-library:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/book-reading-tracker-library/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/book-reading-tracker-library/public"
              }
            ],
            "styles": [
              "projects/book-reading-tracker-library/src/styles.scss"
            ],
            "scripts": []
          }
        }
      }
    },
    "book-reading-tracker-library-shared": {
      "projectType": "library",
      "root": "projects/book-reading-tracker-library-shared",
      "sourceRoot": "projects/book-reading-tracker-library-shared/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/book-reading-tracker-library-shared/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/book-reading-tracker-library-shared/tsconfig.lib.json"
            }
          }
        }
      }
    },
    "book-reading-tracker-library-books": {
      "projectType": "library",
      "root": "projects/book-reading-tracker-library-books",
      "sourceRoot": "projects/book-reading-tracker-library-books/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/book-reading-tracker-library-books/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/book-reading-tracker-library-books/tsconfig.lib.json"
            }
          }
        }
      }
    },
    "book-reading-tracker-library-dashboard": {
      "projectType": "library",
      "root": "projects/book-reading-tracker-library-dashboard",
      "sourceRoot": "projects/book-reading-tracker-library-dashboard/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/book-reading-tracker-library-dashboard/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/book-reading-tracker-library-dashboard/tsconfig.lib.json"
            }
          }
        }
      }
    },
    "book-reading-tracker-library-reading-logs": {
      "projectType": "library",
      "root": "projects/book-reading-tracker-library-reading-logs",
      "sourceRoot": "projects/book-reading-tracker-library-reading-logs/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/book-reading-tracker-library-reading-logs/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/book-reading-tracker-library-reading-logs/tsconfig.lib.json"
            }
          }
        }
      }
    },
    "book-reading-tracker-library-reviews": {
      "projectType": "library",
      "root": "projects/book-reading-tracker-library-reviews",
      "sourceRoot": "projects/book-reading-tracker-library-reviews/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/book-reading-tracker-library-reviews/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/book-reading-tracker-library-reviews/tsconfig.lib.json"
            }
          }
        }
      }
    },
    "book-reading-tracker-library-wishlist": {
      "projectType": "library",
      "root": "projects/book-reading-tracker-library-wishlist",
      "sourceRoot": "projects/book-reading-tracker-library-wishlist/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/book-reading-tracker-library-wishlist/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/book-reading-tracker-library-wishlist/tsconfig.lib.json"
            }
          }
        }
      }
    }
  }
}
