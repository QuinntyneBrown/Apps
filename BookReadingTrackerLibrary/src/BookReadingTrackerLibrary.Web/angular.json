{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "book-reading-tracker-library": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "standalone": true
        },
        "@schematics/angular:directive": {
          "standalone": true
        },
        "@schematics/angular:pipe": {
          "standalone": true
        }
      },
      "root": "projects/book-reading-tracker-library",
      "sourceRoot": "projects/book-reading-tracker-library/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/book-reading-tracker-library",
            "index": "projects/book-reading-tracker-library/src/index.html",
            "browser": "projects/book-reading-tracker-library/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/book-reading-tracker-library/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/book-reading-tracker-library/public"
              }
            ],
            "styles": [
              "projects/book-reading-tracker-library/src/styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kB",
                  "maximumError": "4kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "book-reading-tracker-library:build:production"
            },
            "development": {
              "buildTarget": "book-reading-tracker-library:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/book-reading-tracker-library/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/book-reading-tracker-library/public"
              }
            ],
            "styles": [
              "projects/book-reading-tracker-library/src/styles.scss"
            ],
            "scripts": []
          }
        }
      }
    },
    "api": {
      "projectType": "library",
      "root": "projects/api",
      "sourceRoot": "projects/api/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/api/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/api/tsconfig.lib.json"
            }
          }
        }
      }
    },
    "books": {
      "projectType": "library",
      "root": "projects/books",
      "sourceRoot": "projects/books/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/books/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/books/tsconfig.lib.json"
            }
          }
        }
      }
    },
    "dashboard": {
      "projectType": "library",
      "root": "projects/dashboard",
      "sourceRoot": "projects/dashboard/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/dashboard/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/dashboard/tsconfig.lib.json"
            }
          }
        }
      }
    },
    "reading-logs": {
      "projectType": "library",
      "root": "projects/reading-logs",
      "sourceRoot": "projects/reading-logs/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/reading-logs/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/reading-logs/tsconfig.lib.json"
            }
          }
        }
      }
    },
    "reviews": {
      "projectType": "library",
      "root": "projects/reviews",
      "sourceRoot": "projects/reviews/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/reviews/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/reviews/tsconfig.lib.json"
            }
          }
        }
      }
    },
    "wishlist": {
      "projectType": "library",
      "root": "projects/wishlist",
      "sourceRoot": "projects/wishlist/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/wishlist/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/wishlist/tsconfig.lib.json"
            }
          }
        }
      }
    },
    "components": {
      "projectType": "library",
      "root": "projects/components",
      "sourceRoot": "projects/components/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/components/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/components/tsconfig.lib.json"
            }
          }
        }
      }
    }
  }
}
