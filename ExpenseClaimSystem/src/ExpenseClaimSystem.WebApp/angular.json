{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "expense-claim-system": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "standalone": true
        },
        "@schematics/angular:directive": {
          "standalone": true
        },
        "@schematics/angular:pipe": {
          "standalone": true
        }
      },
      "root": "projects/expense-claim-system",
      "sourceRoot": "projects/expense-claim-system/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/expense-claim-system",
            "index": "projects/expense-claim-system/src/index.html",
            "browser": "projects/expense-claim-system/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/expense-claim-system/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/expense-claim-system/public"
              }
            ],
            "styles": [
              "projects/expense-claim-system/src/styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kB",
                  "maximumError": "4kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "expense-claim-system:build:production"
            },
            "development": {
              "buildTarget": "expense-claim-system:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/expense-claim-system/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/expense-claim-system/public"
              }
            ],
            "styles": [
              "projects/expense-claim-system/src/styles.scss"
            ],
            "scripts": []
          }
        }
      }
    },
    "expense-claim-system-shared": {
      "projectType": "library",
      "root": "projects/expense-claim-system-shared",
      "sourceRoot": "projects/expense-claim-system-shared/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/expense-claim-system-shared/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/expense-claim-system-shared/tsconfig.lib.json"
            }
          }
        }
      }
    },
    "expense-claim-system-categories": {
      "projectType": "library",
      "root": "projects/expense-claim-system-categories",
      "sourceRoot": "projects/expense-claim-system-categories/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/expense-claim-system-categories/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/expense-claim-system-categories/tsconfig.lib.json"
            }
          }
        }
      }
    },
    "expense-claim-system-dashboard": {
      "projectType": "library",
      "root": "projects/expense-claim-system-dashboard",
      "sourceRoot": "projects/expense-claim-system-dashboard/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/expense-claim-system-dashboard/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/expense-claim-system-dashboard/tsconfig.lib.json"
            }
          }
        }
      }
    },
    "expense-claim-system-employees": {
      "projectType": "library",
      "root": "projects/expense-claim-system-employees",
      "sourceRoot": "projects/expense-claim-system-employees/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/expense-claim-system-employees/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/expense-claim-system-employees/tsconfig.lib.json"
            }
          }
        }
      }
    },
    "expense-claim-system-expense-claims": {
      "projectType": "library",
      "root": "projects/expense-claim-system-expense-claims",
      "sourceRoot": "projects/expense-claim-system-expense-claims/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/expense-claim-system-expense-claims/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/expense-claim-system-expense-claims/tsconfig.lib.json"
            }
          }
        }
      }
    }
  }
}
