{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "vehicle-value-tracker": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "standalone": true
        },
        "@schematics/angular:directive": {
          "standalone": true
        },
        "@schematics/angular:pipe": {
          "standalone": true
        }
      },
      "root": "projects/vehicle-value-tracker",
      "sourceRoot": "projects/vehicle-value-tracker/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/vehicle-value-tracker",
            "index": "projects/vehicle-value-tracker/src/index.html",
            "browser": "projects/vehicle-value-tracker/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/vehicle-value-tracker/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/vehicle-value-tracker/public"
              }
            ],
            "styles": [
              "projects/vehicle-value-tracker/src/styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kB",
                  "maximumError": "4kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "vehicle-value-tracker:build:production"
            },
            "development": {
              "buildTarget": "vehicle-value-tracker:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/vehicle-value-tracker/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/vehicle-value-tracker/public"
              }
            ],
            "styles": [
              "projects/vehicle-value-tracker/src/styles.scss"
            ],
            "scripts": []
          }
        }
      }
    },
    "vehicle-value-tracker-shared": {
      "projectType": "library",
      "root": "projects/vehicle-value-tracker-shared",
      "sourceRoot": "projects/vehicle-value-tracker-shared/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/vehicle-value-tracker-shared/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/vehicle-value-tracker-shared/tsconfig.lib.json"
            }
          }
        }
      }
    },
    "vehicle-value-tracker-dashboard": {
      "projectType": "library",
      "root": "projects/vehicle-value-tracker-dashboard",
      "sourceRoot": "projects/vehicle-value-tracker-dashboard/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/vehicle-value-tracker-dashboard/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/vehicle-value-tracker-dashboard/tsconfig.lib.json"
            }
          }
        }
      }
    },
    "vehicle-value-tracker-market-comparisons": {
      "projectType": "library",
      "root": "projects/vehicle-value-tracker-market-comparisons",
      "sourceRoot": "projects/vehicle-value-tracker-market-comparisons/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/vehicle-value-tracker-market-comparisons/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/vehicle-value-tracker-market-comparisons/tsconfig.lib.json"
            }
          }
        }
      }
    },
    "vehicle-value-tracker-value-assessments": {
      "projectType": "library",
      "root": "projects/vehicle-value-tracker-value-assessments",
      "sourceRoot": "projects/vehicle-value-tracker-value-assessments/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/vehicle-value-tracker-value-assessments/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/vehicle-value-tracker-value-assessments/tsconfig.lib.json"
            }
          }
        }
      }
    },
    "vehicle-value-tracker-vehicles": {
      "projectType": "library",
      "root": "projects/vehicle-value-tracker-vehicles",
      "sourceRoot": "projects/vehicle-value-tracker-vehicles/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/vehicle-value-tracker-vehicles/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/vehicle-value-tracker-vehicles/tsconfig.lib.json"
            }
          }
        }
      }
    }
  }
}
