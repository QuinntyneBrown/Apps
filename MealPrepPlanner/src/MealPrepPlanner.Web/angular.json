{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "meal-prep-planner": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "standalone": true
        },
        "@schematics/angular:directive": {
          "standalone": true
        },
        "@schematics/angular:pipe": {
          "standalone": true
        }
      },
      "root": "projects/meal-prep-planner",
      "sourceRoot": "projects/meal-prep-planner/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/meal-prep-planner",
            "index": "projects/meal-prep-planner/src/index.html",
            "browser": "projects/meal-prep-planner/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/meal-prep-planner/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/meal-prep-planner/public"
              }
            ],
            "styles": [
              "projects/meal-prep-planner/src/styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kB",
                  "maximumError": "4kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "meal-prep-planner:build:production"
            },
            "development": {
              "buildTarget": "meal-prep-planner:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/meal-prep-planner/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/meal-prep-planner/public"
              }
            ],
            "styles": [
              "projects/meal-prep-planner/src/styles.scss"
            ],
            "scripts": []
          }
        }
      }
    },
    "api": {
      "projectType": "library",
      "root": "projects/api",
      "sourceRoot": "projects/api/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/api/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/api/tsconfig.lib.json"
            }
          }
        }
      }
    },
    "dashboard": {
      "projectType": "library",
      "root": "projects/dashboard",
      "sourceRoot": "projects/dashboard/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/dashboard/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/dashboard/tsconfig.lib.json"
            }
          }
        }
      }
    },
    "grocery": {
      "projectType": "library",
      "root": "projects/grocery",
      "sourceRoot": "projects/grocery/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/grocery/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/grocery/tsconfig.lib.json"
            }
          }
        }
      }
    },
    "meal-plans": {
      "projectType": "library",
      "root": "projects/meal-plans",
      "sourceRoot": "projects/meal-plans/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/meal-plans/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/meal-plans/tsconfig.lib.json"
            }
          }
        }
      }
    },
    "nutrition": {
      "projectType": "library",
      "root": "projects/nutrition",
      "sourceRoot": "projects/nutrition/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/nutrition/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/nutrition/tsconfig.lib.json"
            }
          }
        }
      }
    },
    "recipes": {
      "projectType": "library",
      "root": "projects/recipes",
      "sourceRoot": "projects/recipes/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/recipes/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/recipes/tsconfig.lib.json"
            }
          }
        }
      }
    }
  }
}
