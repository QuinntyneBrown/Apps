{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "college-savings-planner": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "standalone": true
        },
        "@schematics/angular:directive": {
          "standalone": true
        },
        "@schematics/angular:pipe": {
          "standalone": true
        }
      },
      "root": "projects/college-savings-planner",
      "sourceRoot": "projects/college-savings-planner/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/college-savings-planner",
            "index": "projects/college-savings-planner/src/index.html",
            "browser": "projects/college-savings-planner/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/college-savings-planner/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/college-savings-planner/public"
              }
            ],
            "styles": [
              "projects/college-savings-planner/src/styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kB",
                  "maximumError": "4kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "college-savings-planner:build:production"
            },
            "development": {
              "buildTarget": "college-savings-planner:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/college-savings-planner/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/college-savings-planner/public"
              }
            ],
            "styles": [
              "projects/college-savings-planner/src/styles.scss"
            ],
            "scripts": []
          }
        }
      }
    },
    "college-savings-planner-shared": {
      "projectType": "library",
      "root": "projects/college-savings-planner-shared",
      "sourceRoot": "projects/college-savings-planner-shared/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/college-savings-planner-shared/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/college-savings-planner-shared/tsconfig.lib.json"
            }
          }
        }
      }
    },
    "college-savings-planner-beneficiary-list": {
      "projectType": "library",
      "root": "projects/college-savings-planner-beneficiary-list",
