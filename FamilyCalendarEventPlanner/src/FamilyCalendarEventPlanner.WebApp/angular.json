            ],
            "tsConfig": "projects/family-calendar-event-planner-admin/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/family-calendar-event-planner-admin/public"
              }
            ],
            "styles": [
              "@angular/material/prebuilt-themes/azure-blue.css",
              "projects/family-calendar-event-planner-admin/src/styles.scss"
            ],
            "scripts": []
          }
        }
      }
